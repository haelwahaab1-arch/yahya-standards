name: "CodeQL - Yahya Standards"

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  schedule:
    - cron: '30 2 * * 1' # كل اثنين الساعة 2:30 صباحاً

jobs:
  analyze:
    name: Analyze (${{ matrix.language }})
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        language: [ 'javascript-typescript', 'python' ]
        # لو عندك Java أو Go أو C# أضفهم هنا
        # language: [ 'javascript-typescript', 'python', 'java-kotlin', 'go', 'csharp' ]

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Initialize CodeQL
      uses: github/codeql-action/init@v3
      with:
        languages: ${{ matrix.language }}
        # تفعيل استعلامات الأمان + الجودة لنظام يحيى
        queries: security-extended, security-and-quality

    # لو مشروعك JS/TS بدون build معقد، الـ autobuild كافي
    - name: Autobuild
      uses: github/codeql-action/autobuild@v3

    - name: Perform CodeQL Analysis
      uses: github/codeql-action/analyze@v3
      with:
        category: "/language:${{matrix.language}}"
